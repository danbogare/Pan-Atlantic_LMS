NODE_ENV=development
PORT=4000

# MongoDB
MONGO_URI=mongodb://localhost:27017/lms_db

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=
# Mail
# Sender for outgoing emails (must be a domain verified with Resend in production)
MAIL_FROM="Pan-Atlantic LMS <no-reply@yourdomain.com>"

# Number of reverse proxies in front of the API. Usually leave unset: defaults to 1 on Heroku or when NODE_ENV=production, 0 otherwise
TRUST_PROXY=
